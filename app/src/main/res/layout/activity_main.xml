<?xml version="1.0" encoding="utf-8"?>
<!-- Top to bottom: status + room light + sensitivity, one-time setup (until done), the main switch,
     then everything else folded into Advanced settings. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingVertical="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name"
            android:textSize="16sp" android:fontFamily="sans-serif-medium" android:textColor="@color/accent"/>

        <LinearLayout style="@style/Card" android:layout_marginTop="12dp">
            <TextView android:id="@+id/status_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/welcome_title" android:textSize="26sp" android:fontFamily="sans-serif-medium"
                android:textColor="@color/text" android:accessibilityHeading="true" android:accessibilityLiveRegion="polite"/>
            <TextView android:id="@+id/status_detail" style="@style/Body" android:text="@string/welcome_detail"/>
            <TextView android:id="@+id/error" style="@style/Body" android:textColor="@color/warning" android:visibility="gone" android:accessibilityLiveRegion="polite"/>
            <View style="@style/Divider"/>
            <TextView style="@style/SectionTitle" android:text="@string/threshold_title" android:textSize="16sp"/>
            <TextView android:id="@+id/lux_value" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="@string/unknown_lux" android:textColor="@color/accent" android:textSize="15sp"/>
            <com.everyonesniche.nightkeys.ui.LuxMeterView android:id="@+id/lux_meter"
                android:layout_width="match_parent" android:layout_height="58dp" android:importantForAccessibility="no"/>
            <SeekBar android:id="@+id/threshold" android:layout_width="match_parent" android:layout_height="48dp"
                android:contentDescription="@string/threshold_title" android:progressTint="@color/accent" android:thumbTint="@color/accent"/>
            <TextView android:id="@+id/threshold_label" style="@style/Body" android:layout_marginTop="2dp" android:textColor="@color/text"/>
            <TextView style="@style/Body" android:text="@string/threshold_hint" android:textSize="13sp"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/setup_card" style="@style/Card">
            <TextView style="@style/SectionTitle" android:text="@string/setup_title" android:accessibilityHeading="true"/>
            <TextView style="@style/Body" android:text="@string/setup_intro"/>
            <LinearLayout style="@style/StepRow">
                <TextView android:id="@+id/step1_badge" style="@style/StepBadge"/>
                <LinearLayout style="@style/StepText">
                    <TextView style="@style/StepTitle" android:text="@string/step_get"/>
                    <TextView android:id="@+id/step1_detail" style="@style/Body" android:layout_marginTop="2dp" android:text="@string/step_get_detail"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout style="@style/StepRow">
                <TextView android:id="@+id/step2_badge" style="@style/StepBadge"/>
                <LinearLayout style="@style/StepText">
                    <TextView style="@style/StepTitle" android:text="@string/step_start"/>
                    <TextView android:id="@+id/step2_detail" style="@style/Body" android:layout_marginTop="2dp" android:text="@string/step_start_detail"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout style="@style/StepRow">
                <TextView android:id="@+id/step3_badge" style="@style/StepBadge"/>
                <LinearLayout style="@style/StepText">
                    <TextView style="@style/StepTitle" android:text="@string/step_allow"/>
                    <TextView android:id="@+id/step3_detail" style="@style/Body" android:layout_marginTop="2dp"
                        android:text="@string/step_allow_detail" android:accessibilityLiveRegion="polite"/>
                </LinearLayout>
            </LinearLayout>
            <Button android:id="@+id/setup_action" style="@style/PrimaryButton" android:layout_marginTop="20dp" android:text="@string/install_shizuku"/>
            <Button android:id="@+id/guide" style="@style/TextButton" android:text="@string/guide"/>
        </LinearLayout>
        <TextView android:id="@+id/setup_done" style="@style/Body" android:layout_marginTop="16dp" android:paddingHorizontal="4dp"
            android:text="@string/setup_done" android:textColor="@color/accent" android:visibility="gone"/>

        <Button android:id="@+id/main_action" style="@style/PrimaryButton" android:layout_marginTop="16dp"
            android:minHeight="60dp" android:textSize="17sp" android:text="@string/enable"/>
        <TextView android:id="@+id/enable_detail" style="@style/Body" android:gravity="center" android:text="@string/enable_waiting"
            android:accessibilityLiveRegion="polite"/>

        <Button android:id="@+id/advanced_toggle" style="@style/TextButton" android:layout_marginTop="22dp" android:text="@string/advanced_show"/>
        <LinearLayout android:id="@+id/advanced" style="@style/Card" android:layout_marginTop="6dp" android:visibility="gone">
            <CheckBox android:id="@+id/resume_boot" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="@string/resume_boot" android:textColor="@color/text" android:textSize="14sp"/>
            <TextView style="@style/Body" android:text="@string/restart_detail"/>
            <Button android:id="@+id/battery" style="@style/SecondaryButton" android:text="@string/battery"/>
            <Button android:id="@+id/help_guide" style="@style/SecondaryButton" android:text="@string/guide"/>
            <Button android:id="@+id/support" style="@style/SecondaryButton" android:text="@string/copy_report"/>
            <Button android:id="@+id/licenses" style="@style/SecondaryButton" android:text="@string/licenses"/>
            <TextView style="@style/Body" android:layout_marginTop="16dp" android:text="@string/safety_note" android:textColor="@color/warning"/>
            <TextView android:id="@+id/version" style="@style/Body" android:layout_marginTop="16dp" android:gravity="center"/>
            <TextView style="@style/Body" android:text="@string/independent" android:gravity="center"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
